---
const { filename, altText } = Astro.props;
const slug = Astro.url.pathname.split("/").filter(Boolean).pop();
const imageSrc: string = `${import.meta.env.PUBLIC_SITE_URL + import.meta.env.PUBLIC_IMAGE_ASSET_PREFIX}/${slug}/${filename}`;
---

<a
  class="!opacity-100 block w-fit mx-auto"
  href={imageSrc}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Open image ${imageSrc} in a new tab`}
>
  <p>
    <img
      src={imageSrc}
      alt={altText ?? ""}
      draggable="false"
      loading="lazy"
      fetchpriority="low"
    />
  </p>
</a>
